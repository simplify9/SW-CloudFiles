<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>SimplyWorks.CloudFiles.AS</PackageId>
        <Description>Multi-cloud storage abstraction library for Azure Blob Storage. Provides unified file operations with automatic container creation. Part of SW.CloudFiles suite supporting S3, Google Cloud, and Oracle Cloud. See full documentation at https://github.com/simplify9/SW-CloudFiles</Description>
        <PackageTags>cloud storage;azure;blob storage;microsoft azure;file upload;abstraction</PackageTags>
        <Copyright>Simplify9</Copyright>
        <Company>Simplify9</Company>
        <Authors>Simplify9</Authors>
        <Product>SimplyWorks.CloudFiles.AS</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/simplify9/SW-CloudFiles</PackageProjectUrl>
        <RepositoryUrl>https://github.com/simplify9/SW-CloudFiles</RepositoryUrl>
        <PackageIcon>icon.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyVersion>10.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Identity" Version="1.13.2" />
      <!-- 1.6.2, not the newest: 1.7+ needs an Azure.Core where the Identity types moved into Core,
           which clashes with Azure.Identity 1.13 (CS0433) here and in every app referencing both. -->
      <PackageReference Include="Azure.ResourceManager.Storage" Version="1.6.2" />
      <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
        <PackageReference Include="SimplyWorks.PrimitiveTypes" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SW.CloudFiles.AS.UnitTest" />
    <InternalsVisibleTo Include="SW.CloudFiles.AS.Extensions" />
  </ItemGroup>

</Project>
